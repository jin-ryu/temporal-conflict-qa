GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- 실험 03 — 모델 id & 단가 (모델/가격 바뀌면 여기만 수정) ---
GPT_MODEL=gpt-5.5
CLAUDE_MODEL=claude-opus-4-8
GEMINI_MODEL=gemini-3.1-pro-preview   # 정확한 id는 Gemini API 문서에서 확인
# 단가 USD per 1M tokens (input / output) — 현재값 2026-06, 가격 페이지에서 확인 후 갱신
GPT_IN_PRICE=5.0
GPT_OUT_PRICE=30.0
CLAUDE_IN_PRICE=5.0
CLAUDE_OUT_PRICE=25.0
GEMINI_IN_PRICE=2.0
GEMINI_OUT_PRICE=12.0
# Rate limit (requests/min) — 블랙박스 유료 기본(GPT 100 / Claude 50 / Gemini 60). account tier에 맞게 조정
# GPT_RPM=100
# ANTHROPIC_RPM=50
# GEMINI_RPM=60

# vLLM 로컬 서버 (--provider vllm 사용 시)
# 미설정 시 기본값: http://localhost:8000/v1
VLLM_BASE_URL=http://localhost:8000/v1
HF_TOKEN=your-huggingface-token-here
